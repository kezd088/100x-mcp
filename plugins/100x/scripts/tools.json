  {
    "name": "100x_upload_asset",
    "description": "上传参考素材获得 100x 素材编号；最大 20 MB，本地文件优先用包内 media.mjs，避免对话传输 base64。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content_base64": {
          "type": "string",
          "maxLength": 29360128
        },
        "mime_type": {
          "type": "string",
          "maxLength": 40
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        }
      },
      "required": [
        "content_base64",
        "mime_type"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
